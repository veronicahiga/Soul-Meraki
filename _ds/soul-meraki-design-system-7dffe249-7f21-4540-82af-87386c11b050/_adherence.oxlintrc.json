{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/media/**",
              "components/navigation/**",
              "ui_kits/b2b-landing/**",
              "ui_kits/condol-landing/**",
              "ui_kits/recipient-landing/**",
              "ui_kits/social-media/**",
              "ui_kits/social-print/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:SM Gill Sans|SM Gill Sans Condensed|Fraunces))/i]",
        "message": "Font not provided by the design system. Available: SM Gill Sans, SM Gill Sans Condensed, Fraunces."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|fullWidth|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, fullWidth, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|inverse|text)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'inverse' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|bordered|pad|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, bordered, pad, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|paper|alt)$/]",
        "message": "<Card> tone must be one of 'white' | 'paper' | 'alt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|name|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, name, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dedication'] > JSXAttribute > JSXIdentifier[name!=/^(?:to|children|from|tone|showSymbol|width|style|key|ref|className|style|children)$/]",
        "message": "<Dedication> doesn't accept that prop. Declared props: to, children, from, tone, showSymbol, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dedication'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:white|paper)$/]",
        "message": "<Dedication> tone must be one of 'white' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, color, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:div|span|p|h2|h3)$/]",
        "message": "<Eyebrow> as must be one of 'div' | 'span' | 'p' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|as|italic|align|color|children|style|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, as, italic, align, color, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:hero|display|h1|h2|h3|h4)$/]",
        "message": "<Heading> level must be one of 'hero' | 'display' | 'h1' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4|p|div)$/]",
        "message": "<Heading> as must be one of 'h1' | 'h2' | 'h3' | 'h4' | 'p' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Heading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|horizontal|symbol|wordmark|petal)$/]",
        "message": "<Logo> variant must be one of 'full' | 'horizontal' | 'symbol' | 'wordmark' | 'petal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|size|color|mark|style|key|ref|className|style|children)$/]",
        "message": "<Ornament> doesn't accept that prop. Declared props: count, size, color, mark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Ornament'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:symbol|petal)$/]",
        "message": "<Ornament> mark must be one of 'symbol' | 'petal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|shot|tone|style|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt, ratio, shot, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Photo> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaylistTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|artist|duration|key|ref|className|style|children)$/]",
        "message": "<PlaylistTrack> doesn't accept that prop. Declared props: title, artist, duration."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|size|align|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, cite, size, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Quote> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<RadioOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pad|width|align|divider|id|children|style|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: tone, pad, width, align, divider, id, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|white|alt|accent|ink)$/]",
        "message": "<Section> tone must be one of 'paper' | 'white' | 'alt' | 'accent' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='pad'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Section> pad must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='width'] > Literal[value!=/^(?:content|prose|narrow)$/]",
        "message": "<Section> width must be one of 'content' | 'prose' | 'narrow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<Section> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignatureRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|color|size|ruleWidth|style|key|ref|className|style|children)$/]",
        "message": "<SignatureRule> doesn't accept that prop. Declared props: children, color, size, ruleWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|links|legal|style|key|ref|className|style|children)$/]",
        "message": "<SiteFooter> doesn't accept that prop. Declared props: line, links, legal, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<NavLink> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|id|value|defaultValue|onChange|type|multiline|rows|hint|error|required|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, name, id, value, defaultValue, onChange, type, multiline, rows, hint, error, required, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel|number)$/]",
        "message": "<TextField> type must be one of 'text' | 'email' | 'tel' | 'number'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
